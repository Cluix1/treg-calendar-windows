<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TregCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TregCalendar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Treg Calendar">

    <Grid Background="#F3F1E8" Padding="0,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="SidebarToggleButton"
                Width="40"
                MinHeight="40"
                Padding="0"
                Content="Menu"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="#3A3832"
                Click="OnSidebarToggleClicked" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border
                    Width="36"
                    Height="36"
                    Background="#22221E"
                    CornerRadius="8">
                    <Viewbox Margin="6">
                        <TextBlock
                            Text="T"
                            Foreground="#E8DFD2"
                            FontFamily="Georgia"
                            FontWeight="SemiBold" />
                    </Viewbox>
                </Border>
                <Button
                    Padding="0"
                    Content="Treg Calendar"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="#22221E"
                    FontFamily="Georgia"
                    FontSize="20"
                    FontWeight="Normal"
                    Click="OnTodayClicked" />
            </StackPanel>

            <Border
                Grid.Column="2"
                Width="420"
                MinHeight="44"
                HorizontalAlignment="Left"
                Background="#FFFEFA"
                BorderBrush="#BFB6A4"
                BorderThickness="1"
                CornerRadius="22">
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Search"
                        Foreground="#22221E"
                        FontSize="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" />
                    <TextBox
                        x:Name="SearchInput"
                        Grid.Column="1"
                        PlaceholderText="Search for an event"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#3A3832"
                        TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button
                        x:Name="WeekModeButton"
                        Content="Week"
                        Padding="0,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#746F64"
                        Click="OnWeekModeClicked" />
                    <Button
                        x:Name="MonthModeButton"
                        Content="Month"
                        Padding="0,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#22221E"
                        Click="OnMonthModeClicked" />
                    <Button
                        Content="Year"
                        Padding="0,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#746F64"
                        Click="OnYearModeClicked" />
                    <Button
                        x:Name="ScheduleModeButton"
                        Content="Schedule"
                        Padding="0,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#746F64"
                        Click="OnScheduleModeClicked" />
                    <Button
                        x:Name="SearchModeButton"
                        Content="Search"
                        Padding="0,8"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#746F64"
                        Click="OnSearchModeClicked" />
                </StackPanel>

                <Button
                    x:Name="ProfileButton"
                    Width="40"
                    MinHeight="40"
                    Padding="0"
                    Content="U"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="#22221E"
                    Click="OnProfileClicked" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="AuthPopover"
            Grid.Row="1"
            Width="300"
            Padding="16"
            Margin="0,0,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#FFFEFA"
            CornerRadius="8"
            Visibility="Collapsed"
            Canvas.ZIndex="20">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Profile"
                    FontFamily="Georgia"
                    FontSize="18"
                    Foreground="#22221E" />
                <TextBlock
                    x:Name="AuthStatusText"
                    Text="Not signed in."
                    Foreground="#746F64"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="EmailInput"
                    Header="Email"
                    PlaceholderText="you@school.edu"
                    BorderThickness="0,0,0,1"
                    Background="Transparent" />
                <PasswordBox
                    x:Name="PasswordInput"
                    Header="Password"
                    PlaceholderText="Password"
                    BorderThickness="0,0,0,1"
                    Background="Transparent" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button
                        x:Name="SignInButton"
                        Content="Log in"
                        Background="#22221E"
                        BorderBrush="#22221E"
                        Foreground="#FFFEFA"
                        Click="OnSignInClicked" />
                    <Button
                        x:Name="SignOutButton"
                        Content="Log out"
                        Click="OnSignOutClicked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarPanel" Background="#FFFEFA" Padding="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#FAF8F1" CornerRadius="8" Padding="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="MiniMonthTitleText"
                                Text="Month"
                                FontFamily="Georgia"
                                FontSize="16"
                                FontWeight="Normal"
                                Foreground="#22221E"
                                VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button
                                    Width="32"
                                    MinHeight="32"
                                    Padding="0"
                                    Content="&lt;"
                                    Background="#FFFEFA"
                                    BorderBrush="#D9D2C2"
                                    Foreground="#3A3832"
                                    Click="OnPreviousRangeClicked" />
                                <Button
                                    Width="32"
                                    MinHeight="32"
                                    Padding="0"
                                    Content="&gt;"
                                    Background="#FFFEFA"
                                    BorderBrush="#D9D2C2"
                                    Foreground="#3A3832"
                                    Click="OnNextRangeClicked" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="S" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="M" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="T" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="W" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="T" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="F" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="S" Foreground="#746F64" FontSize="12" HorizontalAlignment="Center" />
                        </Grid>

                        <GridView
                            x:Name="CalendarDaysGrid"
                            Grid.Row="2"
                            Background="#FAF8F1"
                            SelectionMode="Single"
                            SelectionChanged="OnCalendarDaySelectionChanged">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="30" Height="30">
                                        <Button
                                            Width="30"
                                            MinHeight="30"
                                            Padding="0"
                                            Content="{Binding DayText}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="#3A3832" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid>
                        <TextBlock
                            Text="Calendars"
                            FontFamily="Georgia"
                            FontSize="16"
                            Foreground="#22221E"
                            VerticalAlignment="Center" />
                        <Button
                            Width="32"
                            MinHeight="32"
                            Padding="0"
                            Content="+"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#3A3832"
                            HorizontalAlignment="Right"
                            Click="OnShowEditorClicked" />
                    </Grid>
                    <Grid MinHeight="36" ColumnSpacing="8" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="18"
                            Height="18"
                            BorderBrush="#BFB6A4"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#EBE7DA"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Treg Calendar"
                            Foreground="#3A3832"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock
                        x:Name="OfflineStoreStatusText"
                        Text="Preparing offline calendar storage..."
                        Foreground="#746F64"
                        FontSize="12"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SyncStatusText"
                        Text="Sync idle."
                        Foreground="#746F64"
                        FontSize="12"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="#FFFEFA" Padding="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        x:Name="RangeTitleText"
                        Text="Calendar"
                        FontFamily="Georgia"
                        FontSize="28"
                        FontWeight="Normal"
                        Foreground="#22221E"
                        VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            x:Name="PreviousRangeButton"
                            Width="36"
                            MinHeight="36"
                            Padding="0"
                            Content="&lt;"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#3A3832"
                            Click="OnPreviousRangeClicked" />
                        <Button
                            x:Name="TodayButton"
                            Content="Today"
                            Background="#FFFEFA"
                            BorderBrush="#D9D2C2"
                            Foreground="#3A3832"
                            Click="OnTodayClicked" />
                        <Button
                            x:Name="NextRangeButton"
                            Width="36"
                            MinHeight="36"
                            Padding="0"
                            Content="&gt;"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#3A3832"
                            Click="OnNextRangeClicked" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="NativeEditorPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#FAF8F1"
                    BorderBrush="#D9D2C2"
                    BorderThickness="1,0,0,0"
                    Padding="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="EventTitleInput"
                            Header="Event"
                            PlaceholderText="Add title"
                            BorderThickness="0,0,0,1"
                            Background="Transparent" />
                        <DatePicker
                            x:Name="EventDateInput"
                            Grid.Column="1"
                            Header="Date" />
                        <TimePicker
                            x:Name="EventTimeInput"
                            Grid.Column="2"
                            Header="Time" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button
                                x:Name="AddEventButton"
                                Content="Save"
                                Background="#22221E"
                                BorderBrush="#22221E"
                                Foreground="#FFFEFA"
                                Click="OnAddEventClicked" />
                            <Button
                                x:Name="SaveEventButton"
                                Content="Save title"
                                Click="OnSaveEventClicked" />
                            <Button
                                x:Name="DeleteEventButton"
                                Content="Delete"
                                Click="OnDeleteEventClicked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="EventsHeadingText"
                        Text="Agenda"
                        FontFamily="Georgia"
                        FontSize="18"
                        FontWeight="Normal"
                        Foreground="#22221E" />
                    <ListView
                        x:Name="EventsList"
                        Grid.Row="1"
                        Background="#FFFEFA"
                        SelectionMode="Single"
                        SelectionChanged="OnEventSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D9D2C2" BorderThickness="0,1,0,0">
                                    <Grid MinHeight="72" Padding="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateText}" Foreground="#22221E" FontFamily="Georgia" FontSize="20" />
                                            <TextBlock Text="{Binding TimeText}" Foreground="#746F64" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#22221E" />
                                            <TextBlock Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" Foreground="#746F64" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding SyncStateText}"
                                            Foreground="#746F64"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <Button
            x:Name="SyncButton"
            Visibility="Collapsed"
            Click="OnSyncClicked" />
        <Button
            x:Name="RefreshButton"
            Visibility="Collapsed"
            Click="OnRefreshClicked" />
        <ComboBox
            x:Name="ViewModeInput"
            Visibility="Collapsed"
            SelectionChanged="OnViewModeChanged">
            <ComboBoxItem Content="Day" />
            <ComboBoxItem Content="Week" />
            <ComboBoxItem Content="Month" />
        </ComboBox>
    </Grid>
</Window>
