<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TregCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TregCalendar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Treg Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    Text="Treg Calendar"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="OfflineStoreStatusText"
                    Text="Preparing offline calendar storage..."
                    Opacity="0.72" />
                <TextBlock
                    x:Name="AuthStatusText"
                    Text="Not signed in."
                    TextWrapping="Wrap"
                    Opacity="0.72" />
                <TextBlock
                    x:Name="SyncStatusText"
                    Text="Sync idle."
                    TextWrapping="Wrap"
                    Opacity="0.72" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="EmailInput"
                        Header="Email"
                        PlaceholderText="you@school.edu" />
                    <PasswordBox
                        x:Name="PasswordInput"
                        Grid.Column="1"
                        Header="Password"
                        PlaceholderText="Password" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button
                        x:Name="SignInButton"
                        Content="Log in"
                        Click="OnSignInClicked" />
                    <Button
                        x:Name="SyncButton"
                        Content="Sync"
                        Click="OnSyncClicked" />
                    <Button
                        x:Name="SignOutButton"
                        Content="Log out"
                        Click="OnSignOutClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousRangeButton"
                    Content="Previous"
                    Click="OnPreviousRangeClicked" />
                <Button
                    x:Name="TodayButton"
                    Grid.Column="1"
                    Content="Today"
                    Click="OnTodayClicked" />
                <Button
                    x:Name="NextRangeButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="OnNextRangeClicked" />
                <TextBlock
                    x:Name="RangeTitleText"
                    Grid.Column="3"
                    Text="Calendar"
                    FontSize="18"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" />
                <ComboBox
                    x:Name="ViewModeInput"
                    Grid.Column="4"
                    SelectedIndex="2"
                    SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="Day" />
                    <ComboBoxItem Content="Week" />
                    <ComboBoxItem Content="Month" />
                </ComboBox>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="5"
                    Content="Refresh"
                    HorizontalAlignment="Right"
                    Click="OnRefreshClicked" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="EventTitleInput"
                    Header="Event"
                    PlaceholderText="New event title" />
                <DatePicker
                    x:Name="EventDateInput"
                    Grid.Column="1"
                    Header="Date" />
                <TimePicker
                    x:Name="EventTimeInput"
                    Grid.Column="2"
                    Header="Time" />
                <StackPanel Grid.Column="3" Spacing="8" VerticalAlignment="Bottom">
                    <Button
                        x:Name="AddEventButton"
                        Content="Add"
                        Click="OnAddEventClicked" />
                    <Button
                        x:Name="SaveEventButton"
                        Content="Save title"
                        Click="OnSaveEventClicked" />
                    <Button
                        x:Name="DeleteEventButton"
                        Content="Delete"
                        Click="OnDeleteEventClicked" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GridView
                    x:Name="CalendarDaysGrid"
                    SelectionMode="Single"
                    SelectionChanged="OnCalendarDaySelectionChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="124" Height="104" Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding WeekdayText}" Opacity="0.72" />
                                    <TextBlock Text="{Binding DayText}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EventSummaryText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ToneText}" Opacity="0.62" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="EventsHeadingText"
                        Text="Agenda"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <ListView
                        x:Name="EventsList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnEventSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,10" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TimeText}" Opacity="0.72" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SyncStateText}"
                                        Opacity="0.72"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
