<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TregCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TregCalendar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Treg Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <StackPanel
            Width="360"
            Spacing="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                Text="Treg Calendar"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Native Windows scaffold is ready. Offline sync comes next."
                Opacity="0.72"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="OfflineStoreStatusText"
                Text="Preparing offline calendar storage..."
                Opacity="0.72"
                HorizontalAlignment="Center" />
            <TextBox
                x:Name="EmailInput"
                Header="Email"
                PlaceholderText="you@school.edu" />
            <PasswordBox
                x:Name="PasswordInput"
                Header="Password"
                PlaceholderText="Password" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button
                    x:Name="SignInButton"
                    Content="Log in"
                    Click="OnSignInClicked" />
                <Button
                    x:Name="SyncButton"
                    Content="Sync"
                    Click="OnSyncClicked" />
                <Button
                    x:Name="SignOutButton"
                    Content="Log out"
                    Click="OnSignOutClicked" />
            </StackPanel>
            <TextBlock
                x:Name="AuthStatusText"
                Text="Not signed in."
                TextWrapping="Wrap"
                Opacity="0.72"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
