{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treg.foo/schemas/sync-response.schema.json",
  "title": "Treg Calendar Sync Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["server_time", "next_sync_cursor", "accepted_mutation_ids", "conflicts", "events"],
  "properties": {
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "next_sync_cursor": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_mutation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
